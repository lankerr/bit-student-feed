[Unit]
Description=BIT feed: keep WeRead and public-platform logins alive, then check alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bitfeed
Group=bitfeed
WorkingDirectory=/opt/bitfeed-site
Environment=BITFEED_DATA=/var/lib/bitfeed-live
Environment=BITFEED_WEREAD_DIR=/var/lib/bitfeed-weread
Environment=BITFEED_WECHAT_DIR=/var/lib/bitfeed-wechat
EnvironmentFile=-/etc/bitfeed/runtime.env
ExecStart=-/opt/bitfeed-site/.venv/bin/python -m bitfeed session-keepalive
ExecStart=/opt/bitfeed-site/.venv/bin/python -m bitfeed alerts
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitfeed-live /var/lib/bitfeed-wechat /var/lib/bitfeed-weread
UMask=0077
MemoryMax=128M
TimeoutStartSec=300
