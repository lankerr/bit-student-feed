[Unit]
Description=BIT public feed classification and daily export
After=network-online.target bitfeed-pipeline.service
Wants=network-online.target

[Service]
Type=oneshot
User=bitfeed
Group=bitfeed
WorkingDirectory=/opt/bitfeed-site
Environment=BITFEED_DATA=/var/lib/bitfeed-site
EnvironmentFile=-/etc/bitfeed/runtime.env
ExecStart=/opt/bitfeed-site/.venv/bin/python -m bitfeed daily --source http://127.0.0.1:18780/feed.json?days=90&limit=5000 --output /var/lib/bitfeed-pipeline/site
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitfeed-site /var/lib/bitfeed-pipeline/site
UMask=0027
MemoryMax=256M
TimeoutStartSec=1800

