[Unit]
Description=BIT public feed classification and daily export
After=network-online.target bitfeed-pipeline.service
Wants=network-online.target

[Service]
Type=oneshot
User=bitfeed
Group=bitfeed
WorkingDirectory=/opt/bitfeed-site
Environment=BITFEED_DATA=/var/lib/bitfeed-live
Environment=BITFEED_WECHAT_AUTH=/var/lib/bitfeed-wechat/session.json
EnvironmentFile=-/etc/bitfeed/runtime.env
ExecStart=/opt/bitfeed-site/.venv/bin/python -m bitfeed server-daily --output /var/lib/bitfeed-pipeline/site
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitfeed-live /var/lib/bitfeed-wechat /var/lib/bitfeed-pipeline/site
UMask=0027
MemoryMax=256M
TimeoutStartSec=1800

