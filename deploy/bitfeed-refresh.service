[Unit]
Description=BIT feed: classify new items with the school model and re-export
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bitfeed
Group=bitfeed
WorkingDirectory=/opt/bitfeed-site
Environment=BITFEED_DATA=/var/lib/bitfeed-live
EnvironmentFile=-/etc/bitfeed/runtime.env
ExecStart=/opt/bitfeed-site/.venv/bin/python -m bitfeed refresh --output /var/lib/bitfeed-pipeline/site
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitfeed-live /var/lib/bitfeed-pipeline/site
UMask=0027
MemoryMax=256M
TimeoutStartSec=1800
