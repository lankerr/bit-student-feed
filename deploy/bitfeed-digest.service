[Unit]
Description=BIT feed: send the twice-weekly Feishu digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bitfeed
Group=bitfeed
WorkingDirectory=/opt/bitfeed-site
Environment=BITFEED_DATA=/var/lib/bitfeed-live
EnvironmentFile=-/etc/bitfeed/runtime.env
ExecStart=/opt/bitfeed-site/.venv/bin/python -m bitfeed feishu-digest
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitfeed-live
UMask=0027
MemoryMax=128M
TimeoutStartSec=300
