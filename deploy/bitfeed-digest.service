[Unit]
Description=BIT feed: send the Saturday forward activity edition
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bitfeed
Group=bitfeed
WorkingDirectory=/opt/bitfeed-site
Environment=BITFEED_DATA=/var/lib/bitfeed-live
Environment=BITFEED_SITE_DIR=/var/lib/bitfeed-pipeline/site
EnvironmentFile=-/etc/bitfeed/runtime.env
ExecStart=/opt/bitfeed-site/.venv/bin/python -m bitfeed weekly-send --no-model --output /var/lib/bitfeed-pipeline/site
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitfeed-live /var/lib/bitfeed-pipeline/site
UMask=0022
MemoryMax=192M
TimeoutStartSec=1500
