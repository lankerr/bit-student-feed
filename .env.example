# Runtime secrets belong on the VPS, never in GitHub or the static site.
BITFEED_DATA=./data
BITFEED_BIND=127.0.0.1
BITFEED_PORT=18780
BITFEED_PUBLIC_URL=https://lankerr.github.io/bit-student-feed/

# Copy the actual API endpoint/request format from the BIT platform console.
# The classifier does not guess a private endpoint or reuse browser cookies.
BIT_AGENT_API_KEY=
BIT_AGENT_APP_ID=d40cplanj0bs73aatf90
BIT_AGENT_CONTRACT=/etc/bitfeed/school-api.json
BIT_AGENT_DAILY_REQUEST_LIMIT=20
BIT_AGENT_BATCH_SIZE=20
BIT_AGENT_MAX_INPUT_CHARS=20000

# Feishu remains off until an actual test group has received and checked a card.
FEISHU_TEST_WEBHOOK=
FEISHU_TEST_SIGNING_SECRET=
FEISHU_PRODUCTION_WEBHOOK=
FEISHU_PRODUCTION_SIGNING_SECRET=
BITFEED_PRODUCTION_SEND=false
